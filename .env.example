# =============================================================================
# WWNN configuration. Copy to .env and fill in. Never commit .env (it is git-ignored).
# Every variable is optional unless marked REQUIRED; defaults are shown.
# Naming: TELEGRAM_*, NEWSDATA_*, OLLAMA_*, LONGCAT_*, YOUTUBE_*, CHATTERBOX_* as-is,
# everything else WWNN_<SETTING>.
# =============================================================================

# ---- paths / run mode --------------------------------------------------------
# On the server keep data, assets and models OUTSIDE the repo. The same absolute paths are
# mounted into every container (see docker-compose.yml).
WWNN_DATA_DIR=/srv/wwnn/data
WWNN_ASSETS_DIR=/srv/wwnn/assets
# used only by docker-compose.yml for volume mounts (ollama/, hf/, longcat/, torch_cache/)
WWNN_MODELS_DIR=/srv/wwnn/models
# local  = run TTS/LongCat/compose in this Python process (inside a container, or a dev box)
# docker = host orchestrator launches `docker compose run --rm <tts|longcat|compose>` per stage
WWNN_STAGE_RUNNER=docker
WWNN_COMPOSE_FILE=/opt/wwnn/docker-compose.yml
WWNN_TIMEZONE=Europe/Berlin
# 1 = mocks for Ollama/TTS/LongCat/YouTube (CPU only). `wwnn dry-run` sets this itself.
WWNN_DRY_RUN=0

# ---- Telegram (REQUIRED) -----------------------------------------------------
# Create a bot with @BotFather, then message it once and read your ids via @userinfobot.
TELEGRAM_BOT_TOKEN=000000000:REPLACE_ME
# chat that receives proposals, audio previews and review checklists (your private chat id)
TELEGRAM_CHAT_ID=REPLACE_ME
# comma separated numeric user ids allowed to press buttons / run commands
TELEGRAM_ALLOWED_USER_IDS=REPLACE_ME
# dry runs write messages to data/telegram_outbox.jsonl unless this is 1
TELEGRAM_IN_DRY_RUN=0
# testing only: answer both gates automatically (never in production)
WWNN_AUTO_APPROVE=0
WWNN_SELECTION_DEADLINE_HOURS=30
WWNN_APPROVAL_REMINDER_HOURS=24

# ---- story sources -------------------------------------------------------------
# NewsData.io free tier (200 credits/day, delayed results). Empty = RSS only.
NEWSDATA_API_KEY=
NEWSDATA_QUERIES=bizarre OR weird OR odd|absurd OR peculiar OR eccentric
NEWSDATA_LANGUAGE=en
# "name|url,name|url". Default: UPI Odd News, NPR Strange News, Sky Strange, Oddity Central
# WWNN_RSS_FEEDS=upi_odd|https://rss.upi.com/news/odd_news.rss,npr_strange|https://feeds.npr.org/1146/rss.xml
WWNN_PROPOSAL_LIVE_COUNT=5
WWNN_PROPOSAL_ARCHIVE_COUNT=3
WWNN_ARCHIVE_COOLDOWN_WEEKS=26

# ---- Ollama (local LLM) --------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
# A general instruct model writes better English satire than a coder model.
# 24 GB: qwen2.5:14b-instruct or hermes3:8b; 48 GB: qwen2.5:32b-instruct
OLLAMA_MODEL=qwen2.5:32b-instruct
# taboo classifier model (empty = OLLAMA_MODEL); a small model is fine
OLLAMA_CLASSIFIER_MODEL=
OLLAMA_USE_CLASSIFIER=1
OLLAMA_TEMPERATURE=0.8
OLLAMA_TIMEOUT_S=600
# docker-compose image for the ollama service; pin a version tag for reproducibility
OLLAMA_IMAGE=ollama/ollama:latest

# ---- pacing ----------------------------------------------------------------------
# Video A total incl. bumpers. Annika's segment IS the Short, so her speech is capped.
WWNN_VIDEO_A_MIN_S=180
WWNN_VIDEO_A_MAX_S=300
WWNN_ANNIKA_MAX_SPEECH_S=50
WWNN_SHORT_MAX_S=59
WWNN_CTA_SECONDS=3.5
WWNN_WPM_TOM=150
WWNN_WPM_ANNIKA=155
WWNN_PACING_MAX_ROUNDS=3
WWNN_POST_TTS_MAX_ROUNDS=2

# ---- TTS: Chatterbox (local, English) ------------------------------------------
# english = ChatterboxTTS (exaggeration/cfg controls), turbo = ChatterboxTurboTTS (faster)
CHATTERBOX_MODEL=english
WWNN_TTS_DEVICE=cuda
# 10-20 s clean mono reference recordings, WITH THE SPEAKERS' WRITTEN CONSENT
WWNN_TOM_VOICE_REF=assets/voices/tom_ref.wav
WWNN_ANNIKA_VOICE_REF=assets/voices/annika_ref.wav
WWNN_TOM_EXAGGERATION=0.30
WWNN_TOM_CFG_WEIGHT=0.55
WWNN_ANNIKA_EXAGGERATION=0.55
WWNN_ANNIKA_CFG_WEIGHT=0.40
WWNN_TTS_TEMPERATURE=0.8
WWNN_TTS_SEED_TOM=1701
WWNN_TTS_SEED_ANNIKA=1887
WWNN_TTS_SENTENCE_PAUSE_S=0.40
WWNN_TTS_SEGMENT_PAUSE_S=0.80
WWNN_TTS_SAMPLE_RATE=48000

# ---- LongCat-Video-Avatar 1.5 ------------------------------------------------------
# HONEST VRAM NOTE: the official single-GPU INT8 distilled path was measured at ~40 GB peak.
#   standard : official script (+ our patch), needs a 40-48 GB card (A6000 / L40S / A100 / H100)
#   offload  : official script, KV-cache kept in system RAM (slower, a few GB less VRAM)
#   lowmem24 : EXPERIMENTAL unmerged community PR #115 script (torchao weight-only INT8);
#              the only route for 24 GB cards (3090/4090). Build the image with
#              LONGCAT_WITH_LOWMEM_PR=1. Not validated by upstream; expect slower renders.
LONGCAT_VRAM_PROFILE=standard
# auto = on when the GPU has < 70 GB VRAM
LONGCAT_OFFLOAD_KV_CACHE=auto
LONGCAT_WITH_LOWMEM_PR=0
LONGCAT_REPO_DIR=/opt/LongCat-Video
LONGCAT_CHECKPOINT_DIR=/models/LongCat-Video-Avatar-1.5
LONGCAT_MODEL_TYPE=avatar-v1.5
LONGCAT_STAGE_1=ai2v
LONGCAT_USE_DISTILL=1
LONGCAT_USE_INT8=1
# 480p (default, fastest) | 720p
LONGCAT_RESOLUTION=480p
# Optional: render Annika (= the Short) at 720p; a 9:16 crop of 480p is only 270x480 px.
LONGCAT_RESOLUTION_ANNIKA=
LONGCAT_SKIP_VOCAL_SEPARATION=1
LONGCAT_REF_IMG_INDEX=10
LONGCAT_MASK_FRAME_RANGE=3
LONGCAT_SEED_TOM=4242
LONGCAT_SEED_ANNIKA=1887
LONGCAT_NPROC=1
LONGCAT_CONTEXT_PARALLEL=1
# override the entry script (relative to LONGCAT_REPO_DIR); empty = chosen by profile
LONGCAT_SCRIPT=
LONGCAT_EXTRA_ARGS=
# shots longer than this are split at pauses and rendered as separate subprocesses
LONGCAT_MAX_SHOT_S=40
LONGCAT_SHOT_TIMEOUT_S=14400
WWNN_TOM_IMAGE=assets/anchors/tom.png
WWNN_ANNIKA_IMAGE=assets/anchors/annika.png
# WWNN_TOM_PROMPT=...      (default: dark emerald green news studio)
# WWNN_ANNIKA_PROMPT=...   (default: dusty sepia archive room)

# ---- compositing --------------------------------------------------------------------
WWNN_FPS=25
WWNN_VIDEO_A_WIDTH=1920
WWNN_VIDEO_A_HEIGHT=1080
WWNN_SHORT_WIDTH=1080
WWNN_SHORT_HEIGHT=1920
# horizontal centre of Annika's 9:16 crop, 0..1 (match where she sits in the frame)
WWNN_SHORT_CROP_X=0.5
WWNN_X264_PRESET=medium
WWNN_X264_CRF=20
WWNN_TARGET_LUFS=-14
WWNN_BGM_VOLUME=0.25
# script = timings from TTS sentences (exact text); whisper = MoneyPrinterTurbo subtitle.py
WWNN_SUBTITLE_PROVIDER=script
WWNN_SUBTITLE_FONT=Be Vietnam Pro
WWNN_MONO_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf
WWNN_SANS_FONT_FILE=
WWNN_VHS_OSD_TEXT=PLAY
# placeholder assets (generate dummies with `wwnn assets placeholders`; replace with real CI)
WWNN_BUMPER_INTRO=assets/bumpers/intro_16x9.mp4
WWNN_BUMPER_TRANSITION=assets/bumpers/archive_transition_16x9.mp4
WWNN_BUMPER_OUTRO=assets/bumpers/outro_16x9.mp4
# optional 9:16 sting before the Short (counts against the 60 s limit)
WWNN_SHORT_INTRO=
WWNN_LT_TEMPLATE_TOM=assets/lower_thirds/tom_template.png
WWNN_LT_TEMPLATE_ANNIKA=assets/lower_thirds/annika_template.png
WWNN_BGM_NEWS=assets/bgm/news_bed.wav
WWNN_BGM_ARCHIVE=assets/bgm/archive_bed.wav

# ---- YouTube Data API v3 (uploads are ALWAYS private; there is no setting for that) ----
WWNN_UPLOAD_ENABLED=1
# OAuth client of type "Desktop app" from Google Cloud Console (YouTube Data API v3 enabled)
YOUTUBE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=REPLACE_ME
# obtain with: wwnn youtube auth   (put the app in "In production" or the token dies after 7 days)
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
# 23 = Comedy, 25 = News & Politics
YOUTUBE_CATEGORY_ID=23
YOUTUBE_CHANNEL_URL=
